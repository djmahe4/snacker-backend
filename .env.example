# =============================================================================
#  SNACKER BACKEND & HARDWARE CONTROLLER - ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Port & Runtime
PORT=5000
NODE_ENV=development # Set to 'production' in live environments

# Admin Authorization (REQUIRED for admin endpoints; matched against the verified Firebase token email)
ADMIN_EMAIL=you@example.com

# -----------------------------------------------------------------------------
#  YOUPI-PG PAYMENT GATEWAY (Dynamic UPI FCFS Queue)
# -----------------------------------------------------------------------------
# Local Development:
YOUPI_GATEWAY_URL=http://localhost:6100
YOUPI_MERCHANT_ID=snacker-merchant-01
# REQUIRED. The server will not start without it. Generate with: openssl rand -hex 32
YOUPI_WEBHOOK_SECRET=change-me-generate-with-openssl-rand-hex-32

# Production Domain Migration:
# If using Cloudflare Tunnel or custom domain:
# YOUPI_GATEWAY_URL=https://api-pay.yourdomain.com (or https://pay.yourdomain.com)

# -----------------------------------------------------------------------------
#  FIREBASE CLIENT CONFIGURATION
# -----------------------------------------------------------------------------
FIREBASE_API_KEY=AIzaSyDummyKeyForInitialization12345
FIREBASE_AUTH_DOMAIN=snacker-app.firebaseapp.com
FIREBASE_PROJECT_ID=snacker-app
FIREBASE_DATABASE_URL=https://snacker-app-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=snacker-app.appspot.com
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# NOTE: When deploying on a custom domain (e.g. snacker.yourdomain.com),
# you MUST add your domain to Firebase Console -> Authentication -> Settings -> Authorized Domains.

# -----------------------------------------------------------------------------
#  FIREBASE ADMIN SDK (Privileged Backend Service Account)
# -----------------------------------------------------------------------------
# Path to local service account JSON file on the Raspberry Pi:
FIREBASE_SERVICE_ACCOUNT_PATH=/home/pi/snacker/serviceAccountKey.json

# OR Raw JSON string / Base64 string for cloud environments (Vercel, Render, Fly.io):
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"snacker-app",...}'
