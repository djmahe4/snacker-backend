# =============================================================================
#  SNACKER PI DEPLOYMENT CONFIG
# =============================================================================
#  Copy to hardware/pi/pi.conf and edit. pi.conf is gitignored.
#  Read by setup_pi.sh and doctor.sh. Holds paths and ports only: NO secrets.
# =============================================================================

# Linux user that owns the checkouts and runs the services.
# Default: the user running setup_pi.sh (works even under sudo). Recent Raspberry Pi OS
# images have NO 'pi' user, so only hardcode a name here if it really exists.
PI_USER=${SUDO_USER:-$(id -un)}

# Where this repo (snacker-backend) and youpi-pg are cloned.
# Default: wherever this checkout lives, and youpi-pg next to it.
BACKEND_DIR=$(cd "$PI_SCRIPT_DIR/../.." && pwd)
YOUPI_DIR=$(dirname "$BACKEND_DIR")/youpi-pg

# Nginx site. The frontend is on Vercel, so use the Quick Tunnel config.
#   snacker-quick -> hardware/pi/nginx/snacker-quick.conf
NGINX_SITE=snacker-quick

# Ports
BACKEND_PORT=5000        # Express API + payment webhook (api/server.js)
YOUPI_API_PORT=6100      # YouPI-PG payment REST API
YOUPI_CHECKOUT_PORT=7000 # YouPI-PG checkout portal + youpi.js
YOUPI_ADMIN_PORT=6001    # YouPI-PG merchant admin
NGINX_PORT=80

# Firebase Admin service account used by the backend and vending daemon
SERVICE_ACCOUNT_PATH=$BACKEND_DIR/serviceAccountKey.json

# Public HTTPS URL of a NAMED Cloudflare tunnel hostname (see './setup_pi.sh cloudflared'),
# e.g. https://pay.example.com. Leave empty when using the Quick Tunnel ('tunnel' step),
# whose random URL changes on every restart. The tunnel TOKEN is a secret and does not
# belong here: pass it as CLOUDFLARE_TUNNEL_TOKEN or answer the prompt.
PUBLIC_URL=

# YouPI-PG source. Default: our fork (upstream + FamPay email alerts + observer discovery).
# YOUPI_REPO=https://github.com/djmahe4/YouPI-PG.git
