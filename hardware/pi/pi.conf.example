# =============================================================================
#  SNACKER PI DEPLOYMENT CONFIG
# =============================================================================
#  Copy to hardware/pi/pi.conf and edit. pi.conf is gitignored.
#  Read by setup_pi.sh and doctor.sh. Holds paths and ports only: NO secrets.
# =============================================================================

# Linux user that owns the checkouts and runs the services
PI_USER=pi

# Where this repo (snacker-backend) and youpi-pg are cloned
BACKEND_DIR=/home/pi/snacker-backend
YOUPI_DIR=/home/pi/youpi-pg

# Nginx site. The frontend is on Vercel, so use the Quick Tunnel config.
#   snacker-quick -> hardware/pi/nginx/snacker-quick.conf
NGINX_SITE=snacker-quick

# Ports
BACKEND_PORT=5000        # Express API + payment webhook (api/server.js)
YOUPI_API_PORT=6100      # YouPI-PG payment REST API
YOUPI_CHECKOUT_PORT=7000 # YouPI-PG checkout portal + youpi.js
YOUPI_ADMIN_PORT=6001    # YouPI-PG merchant admin
NGINX_PORT=80

# Firebase Admin service account used by the backend and vending daemon
SERVICE_ACCOUNT_PATH=/home/pi/snacker-backend/serviceAccountKey.json
