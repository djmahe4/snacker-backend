[Unit]
Description=Snacker Vending Controller (Fingers W106 Scanner + Arduino Mega)
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/snacker
ExecStart=/home/pi/snacker/venv/bin/python3 /home/pi/snacker/hardware/pi/vending_controller.py
Restart=always
RestartSec=3
# Rewritten by setup_pi.sh from SERVICE_ACCOUNT_PATH in pi.conf
Environment=FIREBASE_SERVICE_ACCOUNT_PATH=/home/pi/snacker-backend/serviceAccountKey.json
# Logging: INFO by default. For debugging: sudo systemctl edit snacker-vending, add
#   [Service]
#   Environment=LOG_LEVEL=DEBUG
# then restart. PYTHONUNBUFFERED makes any stray print() reach the journal immediately.
Environment=LOG_LEVEL=INFO
Environment=PYTHONUNBUFFERED=1

# Output logs to systemd journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
