rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Products: anyone can read product details and inventory count.
    // Client writes are disabled (only server routes with Firebase Admin SDK can modify catalog & stock).
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // 2. Users: wallet balances and profiles are private. Auth is Clerk (not Firebase Auth), so
    // clients have no identity Firestore can check; the Next.js server routes (/api/wallet) read
    // with the Admin SDK on the signed-in user's behalf.
    match /users/{userId} {
      allow read, write: if false;
    }

    // 3. Orders: order IDs double as the vending QR codes, so they must never be listable or
    // readable by clients. The orders page reads through the Admin SDK for the signed-in user only.
    match /orders/{orderId} {
      allow read, write: if false;
    }

    // 4. Payments: strictly private to server and webhook processing.
    match /payments/{paymentId} {
      allow read, write: if false;
    }

    // 5. Errors: internal error and jam audit logs (server / Pi admin only).
    match /errors/{errorId} {
      allow read, write: if false;
    }

    // Default catch-all: deny all client access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
